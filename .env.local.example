# Supabase (obrigatório para auth + claims)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key

# Service role — só no servidor (admin / upload). NUNCA no browser.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Allowlist de e-mails do /admin (separados por vírgula)
ADMIN_EMAILS=voce@email.com,nathaly@email.com
